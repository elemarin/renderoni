{
  "name": "renderoni",
  "version": "0.1.0",
  "description": "Open-source Three.js game engine for TypeScript with Rapier physics, deterministic simulation, headless testing, and MCP tooling for AI agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "renderoni": "./bin/renderoni.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js"
    },
    "./animation": {
      "types": "./dist/animation/index.d.ts",
      "import": "./dist/animation/index.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./vfx": {
      "types": "./dist/vfx/index.d.ts",
      "import": "./dist/vfx/index.js"
    },
    "./network": {
      "types": "./dist/network/index.d.ts",
      "import": "./dist/network/index.js"
    },
    "./scene": {
      "types": "./dist/scene/index.d.ts",
      "import": "./dist/scene/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing/matchers": {
      "types": "./dist/testing/matchers.d.ts",
      "import": "./dist/testing/matchers.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elemarin/renderoni.git"
  },
  "homepage": "https://elemarin.github.io/renderoni/",
  "bugs": {
    "url": "https://github.com/elemarin/renderoni/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "threejs",
    "three-js",
    "rapier",
    "rapier3d",
    "game-engine",
    "3d-game-engine",
    "web-game-engine",
    "browser-game-engine",
    "javascript-game-engine",
    "physics-engine",
    "model-context-protocol",
    "mcp",
    "mcp-server",
    "ai-agents",
    "agentic-ai",
    "deterministic",
    "simulation",
    "typescript",
    "gamedev",
    "webgl",
    "webgpu",
    "wasm",
    "headless",
    "vitest"
  ],
  "author": "Esteban Leandro Marín",
  "license": "MIT",
  "dependencies": {
    "@sinclair/typebox": "^0.34.14",
    "nipplejs": "^1.0.4",
    "xxhash-wasm": "^1.1.0",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@dimforge/rapier3d-compat": ">=0.13.0",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier3d-compat": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@types/node": "^22.10.2",
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
